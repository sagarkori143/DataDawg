# ─────────────────────────────────────────────────────────────────────────────
# Ollive — copy to `.env` and fill in. Every value is read through
# packages/config, which validates the whole environment ONCE at boot and
# exits loudly if anything is missing or malformed.
#
# No service reads process.env directly. That is what makes these services
# container-ready: the same binary, a different environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Neon connection string. Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/ollive?sslmode=require

# ── Model providers ─────────────────────────────────────────────────────────
# At least one is required. The chat app offers whichever ones are keyed.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ── Telemetry ingestion ─────────────────────────────────────────────────────
# Where the SDK ships its events.
#   local dev  → http://localhost:3001   (the standalone Fastify service)
#   deployed   → https://<your-app>.vercel.app/api   (the in-app route)
#
# If this is UNSET the SDK transport becomes a no-op with a single startup
# warning. It never throws and never retries into the void — the absence of
# telemetry must not break the app being instrumented.
INGEST_ENDPOINT=http://localhost:3001

# Shared secret between SDK and ingestion. Any non-empty string for local dev.
# The SDK preflights this at startup so a bad key fails at boot, not silently
# at runtime three hours later.
INGEST_API_KEY=dev-local-key-change-me

# Port for the standalone Fastify ingestion service.
INGEST_PORT=3001

# ── Telemetry tuning (all optional — defaults shown) ────────────────────────
# Flush when the buffer reaches this many events...
OLLIVE_BATCH_SIZE=50
# ...or when this many milliseconds have passed, whichever comes first.
OLLIVE_FLUSH_MS=200
# Hard cap on the in-memory buffer. When full, the OLDEST events are dropped
# and counted. We never block the caller and never grow without bound.
OLLIVE_MAX_QUEUE=1000
# How many characters of prompt/completion to keep as a preview.
# Full text lives in `messages`; the event table stays narrow so it scans fast.
OLLIVE_PREVIEW_CHARS=300
# Redaction placement: sdk | ingest | both | off
# `both` is defence in depth — redact before the data leaves the process,
# then re-scan centrally as a safety net.
OLLIVE_REDACTION=both

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
