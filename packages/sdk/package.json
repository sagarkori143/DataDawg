{
  "name": "@ollive/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auto-instrumentation for LLM calls. Proxy-based, with a zero-code loader entry point.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@ollive/config": "*",
    "@ollive/contracts": "*"
  }
}
