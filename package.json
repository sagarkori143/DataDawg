{
  "name": "ollive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight inference logging and ingestion system for LLM applications",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:watch": "tsc -b --watch",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --dry",
    "db:migrate": "npm run migrate --workspace @ollive/db",
    "db:reset": "npm run reset --workspace @ollive/db",
    "dev": "npm run build && concurrently -n web,ingest,dash -c cyan,magenta,green \"npm:dev:web\" \"npm:dev:ingest\" \"npm:dev:dashboard\"",
    "dev:web": "npm run dev --workspace @ollive/web",
    "dev:ingest": "npm run dev --workspace @ollive/ingest",
    "test": "npm run test --workspaces --if-present",
    "db:verify": "npm run verify --workspace @ollive/db",
    "load": "node examples/load/generate.mjs",
    "zero-code": "node --import @ollive/sdk/register examples/zero-code/app.mjs",
    "dev:dashboard": "npm run dev --workspace @ollive/dashboard",
    "db:repair": "npm run repair --workspace @ollive/db",
    "build:packages": "tsc -b packages/contracts packages/config packages/db packages/sdk packages/providers packages/ingest-core",
    "build:packages:dashboard": "tsc -b packages/config packages/db"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
